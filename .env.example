# Wistia media ID for the proof video under the hero.
# Playback behaviour (autoplay, mute, captions, controls) is configured in
# Wistia's Customize panel on the media itself — not here and not in code.
NEXT_PUBLIC_WISTIA_MEDIA_ID=REPLACE_ME

# Cal.com booking link, as it appears after cal.com/ — e.g. agencyappsec/audit
NEXT_PUBLIC_CAL_LINK=REPLACE_ME

# Resend API key, for delivering the fit-form leads. Server-side only — no
# NEXT_PUBLIC_ prefix, or it ships in the browser bundle for anyone to read.
# Create one at resend.com/api-keys; it starts with re_.
RESEND_API_KEY=re_

# Where leads are delivered. Every fit-form submission and every hero email
# lands in this inbox. Nothing is sent until it's set.
LEAD_NOTIFY_EMAIL=

# Sender address. The default below is Resend's shared testing sender, which
# needs no setup but will only deliver to your own Resend account email. To
# send anywhere else, verify a domain at resend.com/domains and use it here.
RESEND_FROM_EMAIL=AgencyAppSec <onboarding@resend.dev>
